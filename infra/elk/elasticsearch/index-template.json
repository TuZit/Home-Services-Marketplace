{
  "index_patterns": ["hsm-logs-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "hsm-logs-policy"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "@version": { "type": "keyword" },
        "message": { "type": "text" },
        "stack_trace": { "type": "text" },
        "logger_name": { "type": "keyword" },
        "thread_name": { "type": "keyword" },
        "level": { "type": "keyword" },
        "level_value": { "type": "integer" },
        "traceId": { "type": "keyword" },
        "userId": { "type": "keyword" },
        "role": { "type": "keyword" },
        "app": { "type": "keyword" },
        "environment": { "type": "keyword" },
        "http_method": { "type": "keyword" },
        "http_status": { "type": "integer" },
        "http_duration_ms": { "type": "long" }
      }
    }
  }
}
